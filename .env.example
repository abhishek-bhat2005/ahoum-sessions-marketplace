# Copy to .env and replace every CHANGE_ME value before using OAuth in production.
DJANGO_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
POSTGRES_DB=ahoum
POSTGRES_USER=ahoum
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql://ahoum:CHANGE_ME_DATABASE_PASSWORD@db:5432/ahoum
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
GITHUB_REDIRECT_URI=http://localhost/api/auth/github/callback/
OAUTH_SUCCESS_URL=http://localhost/auth/callback
OAUTH_FAILURE_URL=http://localhost/auth/callback
COOKIE_SECURE=false
